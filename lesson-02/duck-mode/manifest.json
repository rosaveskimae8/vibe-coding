{
  "manifest_version": 3,
  "name": "Утиный режим",
  "version": "1.0",
  "description": "По сайту гуляет утка, крякает и утаскивает куски страницы!",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Утиный режим 🦆"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Выпустить или убрать утку"
    }
  }
}
